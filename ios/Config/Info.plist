<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AppIdentifierPrefix</key>
	<string>$(AppIdentifierPrefix)</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>runnaio</string>
			</array>
		</dict>
	</array>
	<key>MBXAccessToken</key>
	<string>$(MAPBOX_ACCESS_TOKEN)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Para guardar automáticamente en Fotos los vídeos de tus carreras que creas para compartir.</string>
	<key>NSCameraUsageDescription</key>
	<string>KM2 usa la cámara para que hagas una foto y se la envíes a quien le has robado territorio.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>KM2 no guarda datos en Salud: solo lee tus entrenamientos de carrera y sus rutas GPS para convertirlos en territorio.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>KM2 lee tus entrenamientos de carrera y sus rutas GPS (por ejemplo, del Apple Watch) para convertirlos en territorio conquistado.</string>
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>RunRecording</key>
		<string>KM2 necesita tu ubicación exacta para dibujar bien la ruta de la carrera y calcular el territorio que conquistas.</string>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>KM2 usa tu ubicación para mostrarte en el mapa y registrar la ruta de tus carreras, también con la pantalla bloqueada mientras corres.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>CFBundleSpokenName</key>
	<string>Kaemedos</string>
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>KM2</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>ka eme dos</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>KM 2</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Kaeme dos</string>
		</dict>
	</array>
</dict>
</plist>
